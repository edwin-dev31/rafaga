# Local development only. Override these values in an untracked .env file.
POSTGRES_DB=rafaga_shared
POSTGRES_USER=rafaga_app
POSTGRES_PASSWORD=rafaga_dev
POSTGRES_PORT=5432
REDIS_PORT=6379
RAFAGA_ALLOWED_ORIGINS=http://localhost:3000
KEYCLOAK_PORT=8082
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=rafaga_dev_admin_password
KEYCLOAK_CLIENT_ID=rafaga-backend
KEYCLOAK_CLIENT_SECRET=rafaga_dev_client_secret
RAFAGA_IDENTITY_REGISTRATION_TOKEN=replace-with-a-long-random-secret
KEYCLOAK_ADMIN_CLIENT_ID=rafaga-backend-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=rafaga_dev_admin_client_secret
