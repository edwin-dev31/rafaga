# Local development only. Override these values in an untracked .env file.
# Cloudflare R2. Keep real values only in the untracked .env file or deployment secrets.
MEDIA_R2_ACCOUNT_ID=
MEDIA_R2_ACCESS_KEY_ID=
MEDIA_R2_SECRET_ACCESS_KEY=
MEDIA_R2_BUCKET=rafaga-media
MEDIA_R2_PUBLIC_BASE_URL=https://media.rafaga.com

POSTGRES_DB=rafaga_shared
POSTGRES_USER=rafaga_app
POSTGRES_PASSWORD=rafaga_dev
POSTGRES_PORT=5432
DB_SHARED_USER=rafaga_runtime
DB_SHARED_PASSWORD=rafaga_runtime_dev
REDIS_PORT=6379
RAFAGA_ALLOWED_ORIGINS=http://localhost:3000

# CIDRs used by the Gateway/Cloudflare path. Leave empty locally; production
# must set only the private Gateway network ranges, never a public range.
RAFAGA_TRUSTED_PROXY_CIDRS=
# Public/expensive endpoint protection. Production can override these values.
RAFAGA_RATE_LIMIT_ENABLED=true
RAFAGA_RATE_LIMIT_WINDOW=1m
RAFAGA_RATE_LIMIT_LOGIN_PER_WINDOW=10
RAFAGA_RATE_LIMIT_REGISTRATION_PER_WINDOW=3
RAFAGA_RATE_LIMIT_MEDIA_UPLOAD_PER_WINDOW=12
RAFAGA_RATE_LIMIT_MEDIA_CONFIRMATION_PER_WINDOW=24
RAFAGA_RATE_LIMIT_GUEST_CART_MUTATION_PER_WINDOW=30
RAFAGA_RATE_LIMIT_CHECKOUT_PER_WINDOW=8
RAFAGA_RATE_LIMIT_ORDER_CREATION_PER_WINDOW=12
RAFAGA_RATE_LIMIT_MAX_FALLBACK_ENTRIES=10000

KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=rafaga_dev_admin_password
KEYCLOAK_CLIENT_ID=rafaga-backend
KEYCLOAK_CLIENT_SECRET=rafaga_dev_client_secret
RAFAGA_IDENTITY_REGISTRATION_TOKEN=replace-with-a-long-random-secret
KEYCLOAK_ADMIN_CLIENT_ID=rafaga-backend-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=rafaga_dev_admin_client_secret
