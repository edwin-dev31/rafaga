# Copy to /opt/rafaga/secret-source.env, fill from the approved secret store,
# then chmod it to 0600. This file is consumed only by the provisioning script
# and must never be committed, uploaded to CI logs, or mounted into a container.

DB_SHARED_URL=
DB_SHARED_USER=
DB_SHARED_PASSWORD=
REDIS_PASSWORD=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_CLIENT_SECRET=
RAFAGA_IDENTITY_REGISTRATION_TOKEN=
MEDIA_R2_ACCOUNT_ID=
MEDIA_R2_ACCESS_KEY_ID=
MEDIA_R2_SECRET_ACCESS_KEY=

# Reserved for the Cloudflare and Traefik tasks. Provisioning these now keeps
# their lifecycle in the same rotation inventory, but they are not mounted in
# the backend service until a later task needs them.
CLOUDFLARE_API_TOKEN=
TRAEFIK_INTERNAL_TOKEN=
