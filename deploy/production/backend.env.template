# Copy this file to /opt/rafaga/backend.env on the application VPS, fill it
# with deployment configuration, then chmod it to 0600. Do not put secret
# values here; the matching secrets live in the separately protected
# /opt/rafaga/secret-source.env only while provisioning Docker Swarm secrets.

RAFAGA_SECRETS_REVISION=YYYYMMDD-01

# Required platform ownership and operational contract.
PLATFORM_OPERATIONS_OWNER=
PLATFORM_ALERT_RECIPIENTS=
PLATFORM_APPLICATION_VPS=
PLATFORM_DATA_VPS=
PLATFORM_IDENTITY_VPS=
PLATFORM_REDIS_LOCATION=
PLATFORM_TRAEFIK_PUBLIC_HOST=
PLATFORM_KEYCLOAK_PUBLIC_HOST=

# Backend release selected by the deployment command.
RAFAGA_BACKEND_IMAGE=

# Non-secret backend configuration.
REDIS_CLUSTER_NODES=
REDIS_CLUSTER_MAX_REDIRECTS=3
REDIS_SSL_ENABLED=true
REDIS_CONNECT_TIMEOUT=2s
REDIS_TIMEOUT=2s
KEYCLOAK_JWK_SET_URI=
KEYCLOAK_ISSUER_URI=
KEYCLOAK_CLIENT_ID=rafaga-backend
KEYCLOAK_ADMIN_CLIENT_ID=rafaga-backend-admin
KEYCLOAK_CONNECT_TIMEOUT=2s
KEYCLOAK_READ_TIMEOUT=5s
RAFAGA_ALLOWED_ORIGINS=
RAFAGA_TRUSTED_PROXY_CIDRS=
RAFAGA_MAX_REQUEST_CONTENT_LENGTH=1MB
RAFAGA_MAX_HTTP_REQUEST_HEADER_SIZE=16KB
RAFAGA_MAX_HTTP_FORM_POST_SIZE=1MB
RAFAGA_MAX_HTTP_SWALLOW_SIZE=1MB
RAFAGA_SHUTDOWN_TIMEOUT=30s
RAFAGA_RATE_LIMIT_ENABLED=true
RAFAGA_RATE_LIMIT_WINDOW=1m
RAFAGA_RATE_LIMIT_LOGIN_PER_WINDOW=10
RAFAGA_RATE_LIMIT_REGISTRATION_PER_WINDOW=3
RAFAGA_RATE_LIMIT_MEDIA_UPLOAD_PER_WINDOW=12
RAFAGA_RATE_LIMIT_MEDIA_CONFIRMATION_PER_WINDOW=24
RAFAGA_RATE_LIMIT_GUEST_CART_MUTATION_PER_WINDOW=30
RAFAGA_RATE_LIMIT_CHECKOUT_PER_WINDOW=8
RAFAGA_RATE_LIMIT_ORDER_CREATION_PER_WINDOW=12
RAFAGA_RATE_LIMIT_MAX_FALLBACK_ENTRIES=10000
MEDIA_R2_BUCKET=rafaga-media
MEDIA_R2_PUBLIC_BASE_URL=
MEDIA_R2_CONNECT_TIMEOUT=2s
MEDIA_R2_READ_TIMEOUT=10s
